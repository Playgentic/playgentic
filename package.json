{
  "name": "playgentic",
  "version": "0.4.1",
  "description": "Scaffold an opinionated Playwright-BDD test suite, with optional agent harness for Claude Code, GitHub Copilot and Codex.",
  "type": "module",
  "bin": {
    "playgentic": "bin/cli.mjs"
  },
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run smoke"
  },
  "files": [
    "bin",
    "template"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "bdd",
    "cucumber",
    "claude-code",
    "github-copilot",
    "codex",
    "agentic-ai",
    "scaffold",
    "cli",
    "test-automation",
    "SDET"
  ],
  "author": "Blaise Moses",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Playgentic/playgentic.git"
  },
  "bugs": {
    "url": "https://github.com/Playgentic/playgentic/issues"
  },
  "homepage": "https://github.com/Playgentic/playgentic#readme",
  "publishConfig": {
    "access": "public"
  }
}
