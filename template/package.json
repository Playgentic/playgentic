{
  "name": "playgentic-suite",
  "version": "0.1.0",
  "description": "A BDD Playwright test suite scaffolded with playgentic",
  "private": true,
  "scripts": {
    "test:compile": "npx bddgen",
    "test": "npx bddgen && playwright test",
    "test:headed": "npx bddgen && playwright test --headed",
    "test:debug": "npx bddgen && playwright test --debug",
    "test:trace": "npx bddgen && playwright test --trace on",
    "test:gui": "npx bddgen && playwright test --ui",
    "wiki": "node scripts/gen-wiki.mjs",
    "lint:steps": "node scripts/lint-steps.mjs",
    "report:playwright": "playwright show-report test-artifacts/playwright-report",
    "report:cucumber": "npx http-server test-artifacts -c-1 -a localhost -o cucumber-report.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "artifact-clean": "rm -rf playwright-report test-artifacts test-results"
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "agentic-ai",
    "test-automation",
    "SDET"
  ],
  "author": "Blaise Moses",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
