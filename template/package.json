{
  "name": "playgentic-suite",
  "version": "0.1.0",
  "description": "A BDD Playwright test suite scaffolded with playgentic",
  "private": true,
  "scripts": {
    "test:compile": "npx bddgen",
    "test": "npx bddgen && playwright test",
    "test:headed": "npx bddgen && playwright test --headed",
    "test:debug": "npx bddgen && playwright test --debug",
    "test:trace": "npx bddgen && playwright test --trace on",
    "test:gui": "npx bddgen && playwright test --ui",
    "test:agent": "npx bddgen && playwright test --project=agent-session",
    "wiki": "node scripts/gen-wiki.mjs",
    "lint:steps": "node scripts/lint-steps.mjs",
    "agent:new": "node scripts/new-agent-session.mjs",
    "agent:promote": "node scripts/promote-agent-session.mjs",
    "report:playwright": "playwright show-report test-artifacts/playwright-report",
    "report:cucumber": "npx http-server .artifacts/cucumber-report -c-1 -a localhost -o index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "artifact-clean": "rm -rf playwright-report test-artifacts test-results"
  },
  "keywords": [
    "playwright",
    "playwright-bdd",
    "agentic-ai",
    "test-automation",
    "SDET"
  ],
  "author": "Blaise Moses",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.64.0"
  }
}
